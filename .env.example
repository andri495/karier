# Neon pooled connection string; copy from Neon/Vercel. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Neon direct connection string for schema/import/backup.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
KARIER_ADMIN_USER=admin
# Replace with your own random password, at least 16 characters. No default password.
KARIER_ADMIN_PASSWORD=
